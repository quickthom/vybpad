{
  "name": "vybpad",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:devstack": "concurrently -k -n api,client \"npm run dev --workspace=@vybpad/server\" \"npm run dev --workspace=@vybpad/client -- --host 127.0.0.1 --port 5173\"",
    "build": "tsc --build",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.9.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.4"
  }
}
