# Local development: copy to `.env` (gitignored). See PATTERNS.md PAT-013 and ENVIRONMENTS.md.

# Required for PostgreSQL (used when DB layer is added)
DATABASE_URL=

# Required for JWT access tokens (min 32 characters in production)
JWT_SECRET=

# Required for refresh token signing / cookie signing (min 32 characters in production)
JWT_REFRESH_SECRET=

# API server (default 3001)
PORT=3001

# development | production
NODE_ENV=development

# Browser origin allowed by CORS (default: Vite dev server)
CORS_ORIGIN=http://127.0.0.1:5173

# Client-side API base URL (Vite) — use the same host you open in the browser (127.0.0.1 vs localhost matter for cookies + CORS).
VITE_API_URL=http://127.0.0.1:3001

# --- Playwright E2E (optional overrides; defaults match playwright.config.ts and client/tests/e2e)
# Browser base URL for Playwright (must match Vite when using the dev stack).
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
# API origin for tests that assert against the HTTP API directly.
PLAYWRIGHT_API_URL=http://127.0.0.1:3001
# Parallel worktrees / agents: use a different port pair per clone and set CORS_ORIGIN + VITE_API_URL to match (PATTERNS.md PAT-030).
# If set to any non-empty value, Playwright does not spawn `npm run e2e:devstack`; start API + Vite yourself on the URLs above.
# PLAYWRIGHT_SKIP_WEBSERVER=
