# Local development: copy to `.env` (gitignored). See PATTERNS.md PAT-013.

# Required for PostgreSQL (used when DB layer is added)
DATABASE_URL=

# Required for JWT access tokens (min 32 characters in production)
JWT_SECRET=

# Required for refresh token signing / cookie signing (min 32 characters in production)
JWT_REFRESH_SECRET=

# API server (default 3001)
PORT=3001

# development | production
NODE_ENV=development

# Browser origin allowed by CORS (default: Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Client-side API base URL (Vite)
VITE_API_URL=http://localhost:3001
