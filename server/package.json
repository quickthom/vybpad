{
  "name": "@vybpad/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:e2e": "node dist/index.js",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "db:generate": "sh -c 'export DATABASE_URL=\"${DATABASE_URL:-postgresql://127.0.0.1:5432/vybpad}\"; exec prisma generate --schema=../prisma/schema.prisma'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.8.2",
    "@vybpad/shared": "*",
    "bcrypt": "^6.0.0",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "tsx": "^4.21.0"
  }
}
